@page
@model DW_Projeto_RazorPages.Pages.MemberPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Member[0].RegistrationDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Member[0].Subscribed)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Member[0].Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Member[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Member[0].BirthDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Member[0].CellPhone)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Member) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.RegistrationDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.Subscribed)
            </td>
            <td>
                @Html.DisplayFor(model => item.Id)
            </td>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.BirthDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.CellPhone)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.MemberId">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.MemberId">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.MemberId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
