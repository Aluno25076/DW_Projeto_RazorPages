@page
@model DW_Projeto_RazorPages.Pages.FieldPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Field[0].Size)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Field[0].Number)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Field[0].Type)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Field[0].Matches)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Field) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Size)
            </td>
            <td>
                @Html.DisplayFor(model => item.Number)
            </td>
            <td>
                @Html.DisplayFor(model => item.Type)
            </td>
            <td>
                @Html.DisplayFor(model => item.Matches)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
