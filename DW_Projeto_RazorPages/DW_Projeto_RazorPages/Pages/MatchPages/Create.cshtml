@page
@model DW_Projeto_RazorPages.Pages.MatchPages.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Match</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Match.Day" class="control-label"></label>
                <input asp-for="Match.Day" class="form-control" aria-required="true" />
                <span asp-validation-for="Match.Day" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Match.FieldId" class="control-label"></label>
                @* dropdown com os campos existentes, em vez de um input numérico *@
                <select asp-for="Match.FieldId" class="form-control" aria-required="true"
                        asp-items="ViewBag.FieldId">
                    <option value="">-- Escolha o campo --</option>
                </select>
                <span asp-validation-for="Match.FieldId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}