@page
@model DW_Projeto_RazorPages.Pages.MatchPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

@if (User.IsInRole("Trainer") || User.IsInRole("Administrator")){
    <p>
        <a asp-page="Create">Create New</a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Match[0].Day)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Match[0].FieldFK)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Match[0].Participants)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Match[0].Result)
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Match) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Day)
            </td>
            <td>
                    @Html.DisplayFor(model => item.Field.Number)
            </td>
                <td>
                    @*  @Html.DisplayFor(model => item.ProfessorsList) *@
                    @foreach (var participant in item.Participants)
                    {
                        @Html.DisplayFor(model => participant.Name)
                        <br />
                    }
                </td>
                
                    @if (item.Result is null || item.Result.Wienners.Count == 0)
                    {
                        @if (User.IsInRole("Administrator"))
                        {
                            <td>
                                <a asp-page="./ResultEdit" asp-route-id="@item.Id">Create Result</a>
                            </td>
                        }
                    }
                    else
                    {
                        <td>
                            @if (User.IsInRole("Administrator"))
                            {
                                <a asp-page="./ResultEdit" asp-route-id="@item.Id">Correct Result</a>
                            }
                                <a asp-page="./ResultDetails" asp-route-id="@item.Id">Resultado</a>
                        </td>
                    }

                
                @if (User.IsInRole("Trainer") || User.IsInRole("Administrator"))
                {
                    <td>
                        <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                        @if (User.IsInRole("Administrator"))
                        {
                            <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
                        }
                    </td>
                }
                
        </tr>
}
    </tbody>
</table>
