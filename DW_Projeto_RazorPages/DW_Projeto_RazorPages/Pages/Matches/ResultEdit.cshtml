@page
@model DW_Projeto_RazorPages.Pages.Matches.ResultEditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Match</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Match.Id" />
			<input type="hidden" asp-for="Match.Result.ResultId" />
            <div class="form-group">
                <select asp-for="SelectedWienners" id="wiennersSelect" multiple="multiple" size="6" class="form-control"
                        asp-items="ViewBag.WiennersFK as MultiSelectList">
                    <option value="" disabled>-- Escolha os vencedores --</option>
                </select>
                <span asp-validation-for="SelectedWienners" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}

@*isto permite com que multiplas opções possam ser selecionadas sem a necessidade de primir a tecla Ctrl*@
@*Esta parte do codigo foi completamente gerado por IA*@
<script>
    document.addEventListener('DOMContentLoaded', function() {
            const select = document.getElementById('wiennersSelect');

            select.querySelectorAll('option').forEach(option => {
                option.addEventListener('mousedown', function (e) {
                    e.preventDefault();
                    this.selected = !this.selected;
                    select.dispatchEvent(new Event('change'));
                });
            });
        });
    </script>
}
