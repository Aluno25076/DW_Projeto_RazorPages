@page
@model DW_Projeto_RazorPages.Pages.SubscriptionPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Lista de Planos de Subscrição</h1>

@if (User.IsInRole("Trainer"))
{
    <p>
        <a asp-page="Create">Criar um novo plano de subscrição</a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Subscription[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Subscription[0].Fee)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Subscription[0].FeeAux)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Subscription[0].SubscriptProgram)
            </th>
            @if (User.IsInRole("Trainer"))
            {
                <th>
                    @Html.DisplayNameFor(model => model.Subscription[0].Subscribers)
                </th>
            }
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Subscription) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.Fee)
            </td>
            <td>
                @Html.DisplayFor(model => item.FeeAux)
            </td>
            <td>
                    @Html.DisplayFor(model => item.SubscriptProgram)
            </td>
            @if (User.IsInRole("Trainer"))
            {
                <td>
                    @foreach(var subscriber in item.Subscribers)
                    {
                        @Html.DisplayFor(model => subscriber.Name)
                    }
                </td>
            
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            }
        </tr>
}
    </tbody>
</table>
