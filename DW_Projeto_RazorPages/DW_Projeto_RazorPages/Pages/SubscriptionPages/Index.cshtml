@page
@model DW_Projeto_RazorPages.Pages.SubscriptionPages.IndexModel

@{
    ViewData["Title"] = "Planos de subscrições";
}

<h1>Planos de subscrições</h1>

<p>
    <a asp-page="Create">Criar um novo plano</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Subscription[0].Fee)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Subscription[0].FeeAux)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Subscription[0].Program)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Subscription[0].MembersList)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Subscription) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Fee)
            </td>
            <td>
                @Html.DisplayFor(model => item.FeeAux)
            </td>
            <td>
                @Html.DisplayFor(model => item.Program)
            </td>
            <td>
                @Html.DisplayFor(model => item.MembersList)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Editar</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Detalhes</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Eleminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
