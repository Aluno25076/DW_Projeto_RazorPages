@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirmação do Registo";
}

<h1>@ViewData["Title"]</h1>
@{
    if (@Model.DisplayConfirmAccountLink)
    {
        <p>
            Por favor confirme a criação da sua conta, validando o seu email.<br />
            Foi enviada uma mensagem para o endereço de email que forneceu.<br />
            Confirme, através do <i>link</i> fornecido.<br /><br />
            Se não receber a mensagem, por favor verifique a sua pasta de <i>spam</i>
            ou <a asp-page="./ResendEmailConfirmation">reenvie a confirmação de email</a>.
        </p>
    }
    else
    {
<p>
        Por favor verifique o seu email para confirmar a conta.
</p>
    }
}

