@page "/subscriptions/edit"
@using Microsoft.EntityFrameworkCore
@using DW_Projeto_RazorPages.Data.Model
@inject IDbContextFactory<DW_Projeto_RazorPages.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Subscription</h2>
<hr />
@if (Subscription is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Subscription" OnValidSubmit="UpdateSubscription" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="Subscription.Id" value="@Subscription.Id" />
                <div class="mb-3">
                    <label for="fee" class="form-label">Fee:</label>
                    <InputNumber id="fee" @bind-Value="Subscription.Fee" class="form-control" />
                    <ValidationMessage For="() => Subscription.Fee" class="text-danger" />
                </div>
                <div class="mb-3">
                <span class="text-danger">*</span>
                    <label for="feeaux" class="form-label">FeeAux:</label>
                    <InputText id="feeaux" @bind-Value="Subscription.FeeAux" class="form-control" aria-required="true"/>
                    <ValidationMessage For="() => Subscription.FeeAux" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="program" class="form-label">Program:</label>
                    <InputText id="program" @bind-Value="Subscription.Program" class="form-control" />
                    <ValidationMessage For="() => Subscription.Program" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="memberslist" class="form-label">MembersList:</label>
                    <InputText id="memberslist" @bind-Value="Subscription.MembersList" class="form-control" />
                    <ValidationMessage For="() => Subscription.MembersList" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/subscriptions">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private Subscription? Subscription { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Subscription ??= await context.Subscription.FirstOrDefaultAsync(m => m.Id == Id);

        if (Subscription is null)
        {
            NavigationManager.NotFound();
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateSubscription()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Subscription!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!SubscriptionExists(Subscription!.Id))
            {
                NavigationManager.NotFound();
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/subscriptions");
    }

    private bool SubscriptionExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Subscription.Any(e => e.Id == id);
    }
}
