@page "/subscriptions/create"
@using Microsoft.EntityFrameworkCore
@using DW_Projeto_RazorPages.Data.Model
@inject IDbContextFactory<DW_Projeto_RazorPages.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Subscription</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Subscription" OnValidSubmit="AddSubscription" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="fee" class="form-label">Fee:</label> 
                <InputNumber id="fee" @bind-Value="Subscription.Fee" class="form-control" /> 
                <ValidationMessage For="() => Subscription.Fee" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="feeaux" class="form-label">FeeAux:</label> 
                <InputText id="feeaux" @bind-Value="Subscription.FeeAux" class="form-control" aria-required="true"/> 
                <ValidationMessage For="() => Subscription.FeeAux" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="program" class="form-label">Program:</label> 
                <InputText id="program" @bind-Value="Subscription.Program" class="form-control" /> 
                <ValidationMessage For="() => Subscription.Program" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="memberslist" class="form-label">MembersList:</label> 
                <InputText id="memberslist" @bind-Value="Subscription.MembersList" class="form-control" /> 
                <ValidationMessage For="() => Subscription.MembersList" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/subscriptions">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Subscription Subscription { get; set; } = default!;

    protected override void OnInitialized() => Subscription ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddSubscription()
    {
        using var context = DbFactory.CreateDbContext();
        context.Subscription.Add(Subscription);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/subscriptions");
    }
}
