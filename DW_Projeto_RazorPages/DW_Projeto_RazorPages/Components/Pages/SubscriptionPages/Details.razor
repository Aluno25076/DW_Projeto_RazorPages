@page "/subscriptions/details"
@using Microsoft.EntityFrameworkCore
@using DW_Projeto_RazorPages.Data.Model
@inject IDbContextFactory<DW_Projeto_RazorPages.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>Subscription</h2>
    <hr />
    @if (subscription is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Fee</dt>
            <dd class="col-sm-10">@subscription.Fee</dd>
            <dt class="col-sm-2">FeeAux</dt>
            <dd class="col-sm-10">@subscription.FeeAux</dd>
            <dt class="col-sm-2">Program</dt>
            <dd class="col-sm-10">@subscription.Program</dd>
            <dt class="col-sm-2">MembersList</dt>
            <dd class="col-sm-10">@subscription.MembersList</dd>
        </dl>
        <div>
            <a href="@($"/subscriptions/edit?id={subscription.Id}")">Edit</a> |
            <a href="@($"/subscriptions")">Back to List</a>
        </div>
    }
</div>

@code {
    private Subscription? subscription;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        subscription = await context.Subscription.FirstOrDefaultAsync(m => m.Id == Id);

        if (subscription is null)
        {
            NavigationManager.NotFound();
        }
    }
}
